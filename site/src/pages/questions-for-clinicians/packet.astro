---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrintButton from '../../components/PrintButton.astro';
import PrintPageDisclaimer from '../../components/PrintPageDisclaimer.astro';
import AnalysisVersionBadge from '../../components/AnalysisVersionBadge.astro';
import {
  getClinicianQuestions,
  getLitById,
  getRelease,
  getSiteMode,
  literatureApplicabilityApproved,
} from '../../lib/data';

const questions = getClinicianQuestions();
const release = getRelease();
const mode = getSiteMode();

/** Resolve a literature id to print-safe title + optional applicability note (catalog fields only). */
function litPrintLines(id: string): { id: string; titleLine: string; applicability: string | null } {
  const e = getLitById(id);
  if (!e) {
    return { id, titleLine: id, applicability: null };
  }
  const titleLine = `${id}: ${e.title} (${e.year})`;
  const showApplicability = literatureApplicabilityApproved(id, mode);
  // Prefer quality_notes (why cited / applicability); fall back only to that field — no invented text.
  const applicability =
    showApplicability && e.quality_notes?.trim() ? e.quality_notes.trim() : null;
  return { id, titleLine, applicability };
}

// Chunk into print pages so each physical page carries banner + end disclaimer (P0-2).
const PAGE_SIZE = 4;
const pages: (typeof questions)[] = [];
for (let i = 0; i < questions.length; i += PAGE_SIZE) {
  pages.push(questions.slice(i, i + PAGE_SIZE));
}
if (pages.length === 0) pages.push([]);
---

<BaseLayout
  title="Clinician questions packet"
  currentPath="/questions-for-clinicians/packet/"
  description="Printable clinician question packet. Research only — not medical advice."
  isPrintRoute={true}
>
  <section class="hero hero--tight no-print">
    <div class="legend-label">Printable route</div>
    <h1>Questions for clinicians — packet</h1>
    <p class="lede">
      Printable packet with rationale and citation identifiers. Discussion questions only — not orders.
    </p>
    <AnalysisVersionBadge compact />
    <p class="no-print" style="margin-top: var(--s4);"><PrintButton /></p>
  </section>

  <div class="print-sheet">
    {
      pages.map((chunk, pageIdx) => (
        <section class="print-page" aria-label={`Clinician questions packet page ${pageIdx + 1}`}>
          <PrintPageDisclaimer variant="banner" />
          {pageIdx === 0 && (
            <div class="packet-intro">
              <h2 class="packet-intro-title">About this packet</h2>
              <p class="packet-intro-body">
                {questions.length} research questions raised by an AI-assisted review of Drift0r's
                records. <strong>They are discussion prompts, not orders.</strong> A licensed clinician
                may accept, modify, or reject any item. Nothing here is a protocol or a consumer
                instruction, and no clinician has reviewed this material. Do not start, stop, or change
                treatment based on it.
              </p>
              <p class="packet-intro-meta mono">
                analysis {release.content_version} · evidence through {release.evidence_current_through} · as of {release.as_of} · clinician review: not performed · patient approval:{' '}
                {release.patient_approval.status.replace(/_/g, ' ')}
              </p>
            </div>
          )}
          {chunk.map((q) => {
            const litLines = (q.literature_refs || []).map((id) => litPrintLines(id));
            return (
              <article style="margin: 18px 0; break-inside: avoid; border-bottom: 1px solid #ccc; padding-bottom: 12px;">
                <h2 class="mono" style="font-size: 14px; margin: 0 0 6px;">
                  {q.id} · {q.medical_domain} · research priority: {q.priority}
                  {q.dont_miss ? ' · don’t-miss review priority' : ''}
                </h2>
                <p style="margin: 0 0 8px; font-weight: 600;">{q.question}</p>
                <p style="margin: 0 0 6px; font-size: 13.5px;">
                  <strong>Rationale.</strong> {q.rationale}
                </p>
                <p class="mono" style="margin: 0 0 4px; font-size: 11.5px; color: #444;">
                  claims: {q.related_claim_ids.join(', ') || '—'} · hypotheses:{' '}
                  {q.related_hypothesis_ids.join(', ') || '—'}
                </p>
                <div style="margin: 0; font-size: 11.5px; color: #333;">
                  <strong class="mono" style="font-size: 11.5px; color: #444;">Literature.</strong>{' '}
                  {litLines.length === 0 ? (
                    <span class="mono" style="color: #444;">—</span>
                  ) : (
                    <ul style="margin: 4px 0 0; padding-left: 1.2em;">
                      {litLines.map((row) => (
                        <li style="margin: 0 0 4px; break-inside: avoid;">
                          <span class="mono">{row.titleLine}</span>
                          {row.applicability ? (
                            <span style="display: block; margin-top: 1px; color: #444;">
                              Why cited / applicability: {row.applicability}
                            </span>
                          ) : null}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            );
          })}
          <PrintPageDisclaimer variant="end" />
        </section>
      ))
    }
  </div>
</BaseLayout>
