{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drift0r.local/schemas/release.schema.json",
  "title": "Drift0rSiteRelease",
  "description": "Site release metadata. Research-only publication snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_version",
    "as_of",
    "last_reviewed",
    "evidence_current_through",
    "disclaimer_id",
    "review_status",
    "patient_approval",
    "clinician_review_scope",
    "base_commit",
    "allowlist_version"
  ],
  "properties": {
    "content_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[A-Za-z0-9.]+)?$",
      "description": "Analysis version of the current site package (displayed as Analysis version)."
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidence_current_through": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date through which patient records and literature were considered for this analysis snapshot."
    },
    "disclaimer_id": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "internal_review",
        "patient_review",
        "clinician_review",
        "release_candidate",
        "published",
        "withdrawn"
      ]
    },
    "patient_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_obtained", "obtained", "revoked", "scoped_only"]
        },
        "scope": { "type": "string" },
        "date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notes": {
          "type": "string",
          "description": "No signatures or private consent artifacts."
        }
      }
    },
    "clinician_review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "domains"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_reviewed", "partial", "complete_for_scope"]
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "label_must_not_imply_global": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "base_commit": {
      "type": "string",
      "minLength": 7,
      "description": "Git commit SHA (full or ≥7-char prefix) of the last substantive reviewed content commit this release metadata describes. Not necessarily HEAD if only docs/packet commits followed. Updated when medical content, validators, or release-scope machinery changes in a reviewed way."
    },
    "allowlist_version": {
      "type": "string"
    },
    "noindex": {
      "type": "boolean",
      "default": true
    },
    "ai_models_disclosed": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
