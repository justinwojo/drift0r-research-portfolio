{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drift0r.local/schemas/review-register.schema.json",
  "title": "Drift0rReviewRegister",
  "description": "Machine-readable review dispositions. Never invent approvals.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "as_of", "not_medical_advice", "entries"],
  "properties": {
    "version": { "type": "string" },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "not_medical_advice": { "type": "boolean", "const": true },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact",
        "artifact_author",
        "reviewer_type",
        "scope",
        "date",
        "disposition",
        "evidence_location"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REV-[0-9]{4}$"
        },
        "artifact": { "type": "string" },
        "artifact_author": { "type": "string" },
        "reviewer_type": {
          "type": "string",
          "enum": [
            "ai_model",
            "repository_owner",
            "patient",
            "licensed_clinician",
            "legal_privacy"
          ]
        },
        "reviewer_label": {
          "type": "string",
          "description": "Display name without implying clinical authority for AI models."
        },
        "scope": { "type": "string" },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "disposition": {
          "type": "string",
          "enum": ["pending", "changes_requested", "approved", "blocked", "not_archived"]
        },
        "evidence_location": {
          "type": "string",
          "description": "Path, URL, or explicit note that decision exists only in chat/external correspondence."
        },
        "notes": { "type": "string" }
      }
    }
  }
}
