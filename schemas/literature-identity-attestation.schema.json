{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drift0r.local/schemas/literature-identity-attestation.schema.json",
  "title": "Drift0rLiteratureIdentityAttestation",
  "description": "Persisted external-registry identity check for a literature card. Proves bibliographic identity only — never that a card summary supports a medical claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "literature_id",
    "identifier_type",
    "identifier_value",
    "registry",
    "resolved_title",
    "resolved_year",
    "verified_at",
    "comparison_result",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "literature_id": {
      "type": "string",
      "pattern": "^lit-[0-9]{4}$"
    },
    "identifier_type": {
      "type": "string",
      "enum": ["doi", "pmid", "pmcid"]
    },
    "identifier_value": {
      "type": "string",
      "minLength": 1
    },
    "registry": {
      "type": "string",
      "enum": ["crossref", "ncbi_pubmed", "ncbi_pmc"]
    },
    "resolved_title": {
      "type": "string",
      "minLength": 1
    },
    "resolved_year": {
      "type": ["integer", "null"]
    },
    "resolved_container": {
      "type": "string"
    },
    "card_title": {
      "type": "string"
    },
    "card_year": {
      "type": ["integer", "string", "null"]
    },
    "title_similarity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "year_delta": {
      "type": ["integer", "null"]
    },
    "comparison_result": {
      "type": "string",
      "enum": [
        "match",
        "mismatch",
        "dead_identifier",
        "manual_override",
        "unresolved",
        "network_error_not_recorded"
      ]
    },
    "verified_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp when the registry response was obtained."
    },
    "user_agent": {
      "type": "string"
    },
    "registry_response_excerpt": {
      "type": "object",
      "description": "Minimal audit fields from the registry (not a full dump)."
    },
    "manual_override_reason": {
      "type": ["string", "null"],
      "description": "Required when comparison_result is manual_override."
    },
    "notes": {
      "type": "string"
    },
    "identity_only_disclaimer": {
      "type": "string",
      "const": "Identifier resolution proves bibliographic identity only; it does not prove that the card summary supports any medical claim."
    }
  }
}
