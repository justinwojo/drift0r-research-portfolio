{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drift0r.local/schemas/hypothesis.schema.json",
  "title": "Drift0rHypothesis",
  "description": "Research hypothesis card. Confidence is a single enum — do not encode compound meanings. Research only; not a diagnosis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "confidence",
    "summary",
    "review_status",
    "as_of"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^H[A-Z0-9-]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "architecture",
        "module",
        "single_primary",
        "residual",
        "null_model"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "speculative",
        "not_supported"
      ]
    },
    "architecture_confidence": {
      "type": ["string", "null"],
      "enum": ["high", "medium", "low", "speculative", "not_supported", null],
      "description": "Optional dual bucket for stack architectures; do not merge into confidence."
    },
    "module_confidence": {
      "type": ["string", "null"],
      "enum": ["high", "medium", "low", "speculative", "not_supported", null]
    },
    "summary": { "type": "string" },
    "explains_claim_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CLM-[0-9]{4}$" }
    },
    "does_not_explain_claim_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CLM-[0-9]{4}$" }
    },
    "supporting_literature_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^lit-[0-9]{4}$" }
    },
    "contradicting_literature_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^lit-[0-9]{4}$" }
    },
    "open_question_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "not_reviewed",
        "source_audited",
        "patient_reviewed",
        "clinician_reviewed"
      ]
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "supersedes": {
      "type": ["string", "null"]
    }
  }
}
