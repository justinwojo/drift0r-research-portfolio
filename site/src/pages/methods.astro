---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnalysisVersionBadge from '../components/AnalysisVersionBadge.astro';
import { getClaims, getRelease, metrics } from '../lib/data';
import { getSiteMode } from '../lib/publication';
import { KIND_LABELS, VERIFICATION_LABELS } from '../lib/constants';
import { withBase } from '../lib/paths';

const release = getRelease();
// Rendered to visitors — must reflect the build, not a hardcoded assumption.
const mode = getSiteMode();
const m = metrics();
const claims = getClaims();

/** Plain-language gloss for each claim kind, alongside the live count on this release. */
const KIND_NOTES: Record<string, string> = {
  observed_fact: 'A number or finding that appears in a document. Nobody drew a conclusion from it yet.',
  reported_history: 'Something the patient stated. Recorded as testimony, never promoted to a measurement.',
  interpretation: 'A reading of what one or more findings mean. This is where analysis begins.',
  hypothesis: 'A candidate explanation. Never a diagnosis.',
  research_question: 'A gap written as a question for a licensed clinician to answer.',
};

const kindRows = Object.entries(KIND_LABELS).map(([key, meta]) => ({
  key,
  label: meta.label,
  glyph: meta.glyph,
  css: meta.css,
  note: KIND_NOTES[key] || '',
  count: claims.filter((c) => c.kind === key).length,
}));

/** Verification tiers, strongest first, with the live count of claims sitting at each. */
const VERIFICATION_ORDER = [
  'verified',
  'partially_verified',
  'contested',
  'not_verified',
  'unsupported',
] as const;

const verificationRows = VERIFICATION_ORDER.map((key) => ({
  key,
  label: VERIFICATION_LABELS[key].label,
  count: claims.filter((c) => c.verification_status === key).length,
}));

/**
 * Model roles. These four builds account for every AI contribution to the portfolio —
 * no other model or variant was used for any task (governance/AI_METHODS.md). Fable 5 is a
 * second build within the Claude family, so the family count stays three.
 */
const MODEL_ROLES = [
  {
    family: 'Claude',
    build: 'Opus 5',
    maker: 'Anthropic',
    role: 'Round-1 swarm analysis, design package, final go/no-go audit',
  },
  {
    family: 'Claude',
    build: 'Fable 5',
    maker: 'Anthropic',
    role: 'Round-2 solo blinded re-derivation + adversarial cross-exam (2026-08-10); community-issue adjudication',
  },
  {
    family: 'Codex',
    build: 'GPT-5.6 Sol',
    maker: 'OpenAI',
    role: 'Independent findings pass, dispositions, adversarial audit',
  },
  {
    family: 'Grok',
    build: 'Grok 4.5',
    maker: 'xAI',
    role: 'Prelaunch remediation, adversarial audit remediation',
  },
];

const CANNOT_DO = [
  {
    head: 'Cannot diagnose or prescribe',
    body: 'Licensed clinicians interpret records and decide care. Nothing here is an instruction.',
  },
  {
    head: 'Cannot read a primary record',
    body: `No original laboratory report, DXA printout, radiology report, or clinic note has been reviewed by this project. ${m.verifiedPrimary} of ${m.claimCount} claims are verified against an original instrument record.`,
  },
  {
    head: 'Cannot invent missing records',
    body: 'When a primary instrument report is absent, the question stays open rather than being filled in.',
  },
  {
    head: 'Cannot upgrade evidence by consensus',
    body: 'Agreement among models does not change a verification status. Three models liking a claim is not a source.',
  },
  {
    head: 'Cannot publish excluded files',
    body: 'Local papers, raw community dumps, and patient source PDFs never reach the build artifact.',
  },
];
---

<BaseLayout
  publicationRequiresApprovedClaims={false}
  title="Methods"
  currentPath="/methods/"
  description="How this research portfolio was produced and what the process cannot do."
>
  <section class="hero hero--tight">
    <div class="legend-label">Methods</div>
    <h1>How this was produced</h1>
    <p class="lede">
      Every material statement on this site is a typed record with a source trail and a verification
      status. This page explains how a document becomes a claim, how the models were used, and where
      the method runs out.
    </p>
    <AnalysisVersionBadge compact />
  </section>

  <section class="page-section wrap-prose">
    <h2 class="sec">How a record becomes a claim</h2>
    <p>
      Material statements are not free prose. Every one is filed as one of five kinds, and the kinds
      are never blended — an interpretation cannot quietly become a fact because it was repeated often
      enough. Plain-language summaries and orientation copy are written by hand, but each one names the
      claim rows it rests on and may not state more than they support.
    </p>
    <ul class="kind-list">
      {
        kindRows.map((k) => (
          <li class="kind-row">
            <span class={`kind-glyph badge ${k.css}`} aria-hidden="true">
              {k.glyph}
            </span>
            <span class="kind-main">
              <span class="kind-label">{k.label}</span>
              <span class="kind-note">{k.note}</span>
            </span>
            <span class="kind-count mono">{k.count}</span>
          </li>
        ))
      }
    </ul>
    <p class="record-note">
      Counts are the claims carried in analysis version {release.content_version}. The machine-readable
      kind names are <span class="mono">observed_fact</span>, <span class="mono">reported_history</span>,{' '}
      <span class="mono">interpretation</span>, <span class="mono">hypothesis</span>, and{' '}
      <span class="mono">research_question</span>.
    </p>

    <h3 class="sub">Then it gets a verification status</h3>
    <p>
      Separately from its kind, each claim records how close it sits to an original instrument record.
      This is the number that matters most, and it is the one the project scores worst on.
    </p>
    <ul class="verify-list">
      {
        verificationRows.map((v) => (
          <li class="verify-row">
            <span class="verify-count mono">{v.count}</span>
            <span class="verify-label">{v.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="record-note">
      Public wording is additionally constrained by an audited language guide, so a claim cannot be
      restated more strongly on a page than its record supports. In{' '}
      <span class="mono">publication</span> mode the site ships only explicitly approved claims and
      release-scoped routes; <span class="mono">preview</span> mode shows the wider inventory with
      accurate statuses attached. You are reading <span class="mono">{mode}</span> mode.
    </p>
  </section>

  <section class="page-section wrap-prose">
    <h2 class="sec">How the models were used</h2>
    <p>
      Round 1 (2026-08-05) ran three model families independently on the same records, without sight
      of each other's output, then turned them against each other: each family was instructed to
      attack the others' work for overstatement, missing counterevidence, and provenance gaps. A
      synthesis chair reconciled what survived. A follow-on adversarial audit on 2026-08-06 repeated
      the exercise against the assembled site and produced the corrections logged in the changelog.
    </p>
    <p>
      Round 2 (2026-08-10) added a fourth build, run solo: a blinded agent re-derived its own
      analysis from the evidence pack alone — no sight of this project's hypotheses, ranking, or
      literature cards — and a second agent then attacked both that blinded analysis and the
      published ranking with equal aggression. Because one model family cannot supply cross-family
      independence, the round substituted blinding and role asymmetry for it, and its findings were
      re-verified against the source documents before entering the record. Where the blinded
      derivation landed on a published position without having seen it, that is recorded as a
      re-derivation; where the two disagreed, the compiled source documents adjudicated, and two of the
      blinded analysis's own confidence grades were overturned in the process.
    </p>
    <p>
      Why Fable 5 was absent from Round 1 is worth recording: at that time the build declined
      every task touching this case material, under the deliberately broad biology safeguards it
      launched with. Anthropic later narrowed those safeguards (<a
        href="https://www.anthropic.com/news/improving-fable-5-s-biology-safeguards"
        rel="noopener noreferrer">“Improving Fable 5's biology safeguards”</a>), after which the
      build could work on this material; its first contributions to this project are the
      2026-08-10 roles listed below. The gap reflects the vendor's safety configuration at the
      time, not a judgment about this material, and is why the fourth build arrived as a solo
      round rather than as part of the original three-way review.
    </p>
    <ul class="model-roles">
      {
        MODEL_ROLES.map((r) => (
          <li class="model-role">
            <span class="model-role-name">
              <strong>{r.family}</strong>
              <span class="mono model-role-build">{r.build}</span>
              <span class="model-role-maker">{r.maker}</span>
            </span>
            <span class="model-role-what">{r.role}</span>
          </li>
        ))
      }
    </ul>
    <div class="callout caution">
      <strong class="legend-label">Hard limit</strong>
      <p style="margin: 8px 0 0;">
        Multi-model agreement is <strong>not</strong> clinical validation. Models share training data
        and failure modes, so they can be wrong together and confident together. No AI system is
        listed anywhere on this site as a clinician, investigator, or medical reviewer, and
        adversarial AI review does not substitute for patient or licensed clinician review.
      </p>
    </div>
    {/*
      Must not claim exact-build completeness. The retained run record states that model build
      identity is unrecoverable for the earliest rounds — they logged the CLI/app version, not the
      served build. Families are known; builds are not, for all of it.
    */}
    <p class="record-note">
      These three model families account for every AI contribution to this portfolio. Exact build
      identity is not recoverable for all of it: the earliest rounds recorded the tool version rather
      than the served model build, and providers update builds behind a stable name.
    </p>
    <details class="raw-disclosure">
      <summary>Verbatim disclosure record for {release.content_version}</summary>
      <ul class="raw-disclosure-list">
        {(release.ai_models_disclosed || []).map((line) => <li class="mono">{line}</li>)}
      </ul>
      <p class="record-note" style="margin: 8px 0 0;">
        Internal milestone codes are retained here unedited so the disclosure is not smoothed over in
        summary.
      </p>
    </details>
  </section>

  <section class="page-section wrap-prose">
    <h2 class="sec">What this process cannot do</h2>
    <ul class="notlist">
      {
        CANNOT_DO.map((item) => (
          <li>
            <strong>{item.head}</strong>
            {item.body}
          </li>
        ))
      }
    </ul>
    <p class="section-more">
      <a href={withBase('/how-this-could-be-wrong/')}>Seven specific ways this analysis could be wrong →</a>
    </p>
  </section>

  <section class="page-section wrap-prose">
    <h2 class="sec">Sources and literature</h2>
    <p>
      Targeted specialty search passes used a research cutoff of 2026-08-05. The catalog holds{' '}
      <span class="mono">{m.literatureCards}</span> cards covering{' '}
      <span class="mono">{m.uniqueWorks}</span> unique works. Cards may be abstract-only; access and
      license fields are recorded on each one, and duplicate DOI/PMID records are aliased rather than
      deleted so a citation never silently disappears.
    </p>
    <p>
      Patient source documents live in a Google Drive folder under Drift0r's own control — not this
      project's. This site describes and cites those materials but never rehosts them: no original
      patient PDF is shipped in the repository or the static build.
    </p>
    <ul class="notlist">
      <li>
        <strong>Externally controlled</strong>
        Contents may change, be restricted, or be removed at any time. This site does not mirror them,
        and access is Drift0r's to grant or revoke.
      </li>
      <li>
        <strong>Treat as private medical information</strong>
        The folder may include sensitive records, including mental-health specialty summaries.
      </li>
    </ul>
    <p>
      <a
        href="https://drive.google.com/drive/folders/1z_juK9yVdhbzaGJafzzZYZWe3U1cs37e"
        rel="noopener noreferrer"
        target="_blank"
      >
        Patient-hosted source folder (external Google Drive)
      </a>
    </p>
    <p class="record-note">
      Drift0r granted permission to publish this research portfolio. Permission is not endorsement of
      any finding or of the folder's contents, and clinician review has not been performed. Full
      consent and privacy terms are on the <a href={withBase('/legal/')}>legal page</a>.
    </p>
  </section>

  <section class="page-section wrap-prose" style="padding-bottom: 48px;">
    <h2 class="sec">Where the rest lives</h2>
    <ul class="elsewhere">
      <li>
        <a href={withBase('/about/')}>About</a>
        <span>Who built this, and the independence statement — not a clinician, not affiliated with Drift0r.</span>
      </li>
      <li>
        <a href={withBase('/legal/')}>Legal</a>
        <span>Medical disclaimer, consent and privacy, copyright, and withdrawal of consent.</span>
      </li>
      <li>
        <a href={withBase('/how-this-could-be-wrong/')}>How this could be wrong</a>
        <span>Seven named failure modes, with published errata.</span>
      </li>
      <li>
        <a href={withBase('/changelog/')}>Changelog</a>
        <span>Every material change by version, including {m.corrections} logged corrections.</span>
      </li>
      <li>
        <a href={withBase('/about/contribute/')}>How to contribute</a>
        <span>Correction, privacy, and removal requests. Do not post private medical records.</span>
      </li>
    </ul>
  </section>
</BaseLayout>
