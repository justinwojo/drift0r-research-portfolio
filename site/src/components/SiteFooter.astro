---
import { DISCLAIMER_FULL } from '../lib/constants';
import { getRelease } from '../lib/data';
import { indexingProvenanceLabel } from '../lib/indexing';
import { withBase } from '../lib/paths';
import ContributionCta from './ContributionCta.astro';

const release = getRelease();
const indexingLabel = indexingProvenanceLabel(Boolean(release.noindex));
---

<footer class="site-footer" data-site-footer>
  <div class="wrap">
    <aside class="disclaimer" role="note" aria-label="Research-only medical disclaimer (footer)">
      <p class="disclaimer-title">Research only — not medical advice</p>
      <p>{DISCLAIMER_FULL}</p>
    </aside>
    <aside class="creator-disclosure" role="note" aria-label="Creator and independence disclosure">
      <p>
        Created and maintained by <strong>Justin Wojciechowski</strong> (
        <a href="https://github.com/justinwojo" rel="noopener noreferrer">@justinwojo</a>
        ). Independent community research project. Justin is not a clinician. Not operated by, affiliated with, or
        endorsed by Drift0r. Published with Drift0r’s permission; permission is not endorsement. No financial
        relationship with or compensation from Drift0r. AI-assisted portfolio — licensed clinicians must verify all
        findings.
        <a href={withBase('/about/')}>About the project</a>
      </p>
    </aside>
    <ContributionCta variant="footer" />
    <p class="foot-meta">
      analysis version {release.content_version} · evidence current through {release.evidence_current_through} · as of{' '}
      {release.as_of} · review: {release.review_status.replace(/_/g, ' ')} · patient approval:{' '}
      {release.patient_approval.status.replace(/_/g, ' ')} · clinician review: not performed · indexing:{' '}
      {indexingLabel} · base commit {release.base_commit.slice(0, 7)}
    </p>
    <nav class="foot-nav" aria-label="Footer">
      <a href={withBase('/about/')}>About</a>
      <a href={withBase('/changelog/')}>Changelog</a>
      <a href={withBase('/legal/')}>Legal</a>
      <a href={withBase('/about/contribute/')}>Contribute</a>
      <a href={withBase('/about/downloads/')}>Printable routes</a>
      <a href={withBase('/methods/')}>Methods</a>
      <a href={withBase('/how-this-could-be-wrong/')}>How this could be wrong</a>
    </nav>
  </div>
</footer>

<style>
  .creator-disclosure {
    margin: var(--s5, 24px) 0;
    padding: var(--s4, 16px);
    border: var(--b-hair, 1px solid #c9c2b4);
    background: var(--card, #fbfaf7);
    font-size: var(--t-sm, 0.8125rem);
    line-height: 1.5;
    color: var(--muted, #4c5a63);
  }
  .creator-disclosure p {
    margin: 0;
  }
  .creator-disclosure a {
    color: var(--link, #0b4f73);
  }
</style>
